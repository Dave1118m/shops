generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  SELLER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum SaleStatus {
  COMPLETED
  CANCEL_REQUESTED
  CANCELLED
}

enum StockMovementType {
  PURCHASE
  SALE
  RETURN
  WRITE_OFF
  CORRECTION
}

enum MoneyDirection {
  IN
  OUT
}

enum MoneyEntryType {
  SALE
  PURCHASE
  EXPENSE
  OWNER_WITHDRAWAL
  OWNER_INJECTION
}

enum ExpenseCategory {
  RENT
  SALARY
  TRANSPORT
  ELECTRICITY
  PACKAGING
  OTHER
}

model User {
  id           String      @id @default(uuid())
  name         String
  username     String      @unique
  passwordHash String
  role         Role        @default(SELLER)
  status       UserStatus  @default(ACTIVE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  sales          Sale[]
  purchases      Purchase[]
  expenses       Expense[]
  moneyEntries   MoneyEntry[]
  stockMovements StockMovement[]
  dayClosings    DayClosing[]
  auditLogs      AuditLog[]

  @@map("users")
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  items Item[]

  @@map("categories")
}

model Item {
  id           String   @id @default(uuid())
  name         String
  categoryId   String
  code         String?  @unique // Barcode or SKU prefix
  photoUrl     String?
  buyingPrice  Decimal  @default(0) @db.Decimal(18, 2) // Weighted average cost per unit
  sellingPrice Decimal  @db.Decimal(18, 2)
  reorderLevel Int      @default(5)
  unitType     String   @default("PIECE")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category       Category        @relation(fields: [categoryId], references: [id])
  variants       ItemVariant[]
  purchaseLines  PurchaseLine[]
  saleLines      SaleLine[]
  stockMovements StockMovement[]

  @@map("items")
}

model ItemVariant {
  id              String   @id @default(uuid())
  itemId          String
  size            String?  // e.g. "S", "M", "L", "XL", "38", "40"
  color           String?  // e.g. "Red", "Black", "White"
  sku             String?  @unique
  additionalPrice Decimal  @default(0) @db.Decimal(18, 2)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  item           Item            @relation(fields: [itemId], references: [id], onDelete: Cascade)
  purchaseLines  PurchaseLine[]
  saleLines      SaleLine[]
  stockMovements StockMovement[]

  @@map("item_variants")
}

model Purchase {
  id             String         @id @default(uuid())
  purchaseNumber String         @unique
  date           DateTime       @default(now())
  supplier       String?
  extraCost      Decimal        @default(0) @db.Decimal(18, 2) // Shipping, transport, etc.
  notes          String?
  userId         String
  createdAt      DateTime       @default(now())

  user  User           @relation(fields: [userId], references: [id])
  lines PurchaseLine[]

  @@map("purchases")
}

model PurchaseLine {
  id         String   @id @default(uuid())
  purchaseId String
  itemId     String
  variantId  String?
  quantity   Decimal  @db.Decimal(18, 2) // Whole piece or decimal for future
  unitCost   Decimal  @db.Decimal(18, 2)
  totalCost  Decimal  @db.Decimal(18, 2)

  purchase Purchase     @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  item     Item         @relation(fields: [itemId], references: [id])
  variant  ItemVariant? @relation(fields: [variantId], references: [id])

  @@map("purchase_lines")
}

model Sale {
  id             String     @id @default(uuid())
  receiptNo      String     @unique
  date           DateTime   @default(now())
  sellerId       String
  status         SaleStatus @default(COMPLETED)
  discountAmount Decimal    @default(0) @db.Decimal(18, 2)
  totalAmount    Decimal    @db.Decimal(18, 2)
  totalCost      Decimal    @default(0) @db.Decimal(18, 2) // COGS snapshot at time of sale
  cancelReason   String?
  createdAt      DateTime   @default(now())

  seller User       @relation(fields: [sellerId], references: [id])
  lines  SaleLine[]

  @@map("sales")
}

model SaleLine {
  id             String   @id @default(uuid())
  saleId         String
  itemId         String
  variantId      String?
  quantity       Decimal  @db.Decimal(18, 2)
  unitPrice      Decimal  @db.Decimal(18, 2)
  unitCostAtSale Decimal  @db.Decimal(18, 2) // Cost basis locked at time of sale
  subtotal       Decimal  @db.Decimal(18, 2)

  sale    Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  item    Item         @relation(fields: [itemId], references: [id])
  variant ItemVariant? @relation(fields: [variantId], references: [id])

  @@map("sale_lines")
}

model StockMovement {
  id        String            @id @default(uuid())
  itemId    String
  variantId String?
  quantity  Decimal           @db.Decimal(18, 2) // Positive (+) for in, Negative (-) for out
  type      StockMovementType
  reason    String?
  refType   String?           // "PURCHASE", "SALE", "RETURN", "AUDIT", "WRITE_OFF"
  refId     String?
  userId    String
  date      DateTime          @default(now())
  createdAt DateTime          @default(now())

  item    Item         @relation(fields: [itemId], references: [id])
  variant ItemVariant? @relation(fields: [variantId], references: [id])
  user    User         @relation(fields: [userId], references: [id])

  @@map("stock_movements")
}

model Expense {
  id        String          @id @default(uuid())
  category  ExpenseCategory
  amount    Decimal         @db.Decimal(18, 2)
  date      DateTime        @default(now())
  note      String?
  userId    String
  createdAt DateTime        @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("expenses")
}

model MoneyEntry {
  id        String         @id @default(uuid())
  direction MoneyDirection // IN or OUT
  amount    Decimal        @db.Decimal(18, 2)
  type      MoneyEntryType
  refType   String?
  refId     String?
  notes     String?
  userId    String
  date      DateTime       @default(now())
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("money_entries")
}

model DayClosing {
  id           String   @id @default(uuid())
  date         DateTime @default(now())
  openingCash  Decimal  @default(0) @db.Decimal(18, 2)
  expectedCash Decimal  @db.Decimal(18, 2)
  countedCash  Decimal  @db.Decimal(18, 2)
  difference   Decimal  @db.Decimal(18, 2) // countedCash - expectedCash (negative = short, positive = over)
  notes        String?
  closedById   String
  createdAt    DateTime @default(now())

  closedBy User @relation(fields: [closedById], references: [id])

  @@map("day_closings")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String   // e.g. "PRICE_CHANGE", "STOCK_WRITE_OFF", "SALE_CANCELLED"
  entity    String   // e.g. "Item", "Sale", "Stock"
  entityId  String?
  details   String?  // JSON string of before/after or reasoning
  timestamp DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model Setting {
  id    String @id @default(uuid())
  key   String @unique
  value String

  @@map("settings")
}
