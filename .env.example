# SQL Server Connection String
# Example format:
# sqlserver://localhost:1433;database=BoutiqueShopDB;user=sa;password=YourStrongPassword123;encrypt=true;trustServerCertificate=true;
DATABASE_URL="sqlserver://localhost:1433;database=BoutiqueShopDB;user=sa;password=YourStrongPassword123;encrypt=true;trustServerCertificate=true;"

# JWT Secret for Session Tokens
JWT_SECRET="boutique-shop-secret-key-change-this-in-production-2026"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth 2.0 Credentials (Optional - for Google Sign In / Sign Up)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

